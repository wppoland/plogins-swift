#. Plugin Name of the plugin
#: plogins-swift.php
msgid "Swift - Buy Now Button for WooCommerce"
msgstr "Swift - Buy Now Button for WooCommerce"

#. Plugin URI of the plugin
#: plogins-swift.php
msgid "https://plogins.com/plogins-swift/"
msgstr "https://plogins.com/plogins-swift/"

#. Description of the plugin
#: plogins-swift.php
msgid "Add a Buy Now button that takes shoppers straight to checkout, skipping the cart."
msgstr "Añade un botón Comprar ahora que lleva a los compradores directamente al proceso de pago, saltándose el carrito."

#. Author of the plugin
#: plogins-swift.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: plogins-swift.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: plogins-swift.php:48
msgid "Swift - Buy Now Button for WooCommerce requires WooCommerce to be active."
msgstr "Swift - Buy Now Button for WooCommerce requiere que WooCommerce esté activo."


#. Plugin Name of the plugin
#: plogins-swift.php
msgid "Swift - Buy Now Button for WooCommerce"
msgstr "Swift - Buy Now Button for WooCommerce"

#. Plugin URI of the plugin
#: plogins-swift.php
msgid "https://plogins.com/plogins-swift/"
msgstr "https://plogins.com/plogins-swift/"

#. Description of the plugin
#: plogins-swift.php
msgid ""
"Add a Buy Now button that takes shoppers straight to checkout, skipping the "
"cart."
msgstr ""
"Dodaj przycisk Kup teraz, który przenosi klientów prosto do zamówienia, z "
"pominięciem koszyka."

#. Author of the plugin
#: plogins-swift.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: plogins-swift.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: plogins-swift.php:48
msgid ""
"Swift - Buy Now Button for WooCommerce requires WooCommerce to be active."
msgstr "Swift - Buy Now Button for WooCommerce wymaga aktywnego WooCommerce."

